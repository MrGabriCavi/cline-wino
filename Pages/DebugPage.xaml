<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClineWin.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ClineBackgroundBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="856" Style="{StaticResource SettingsPageStackStyle}">
            <TextBlock Style="{StaticResource ClinePageTitleStyle}" Text="Debug" />
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource ClinePageDescriptionStyle}"
                Text="Strumenti per risolvere i problemi di Cline." />

            <InfoBar
                x:Name="ResultBar"
                Margin="0,20,0,0"
                IsOpen="False" />

            <Grid Margin="0,24,0,0" Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Diagnostica" />
                    <TextBlock Style="{StaticResource ClineSettingDescriptionStyle}" Text="Esporta informazioni sull'app e i log recenti in un file da allegare quando segnali un problema. Prompt, contenuto delle conversazioni e chiavi API non vengono mai inclusi." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Center"
                    Click="Export_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE896;" />
                        <TextBlock Text="Esporta…" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Cartella dei log" />
                    <TextBlock
                        x:Name="LogPathText"
                        FontFamily="Cascadia Mono, Consolas"
                        Style="{StaticResource ClineSettingDescriptionStyle}" />
                </StackPanel>
                <Button
                    x:Name="OpenLogsButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OpenLogs_Click"
                    Content="Apri cartella" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
