<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClineWin.SettingsGeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ClineBackgroundBrush}">

    <Page.Resources>
        <!--  Riga della tabella notifiche  -->
        <Style x:Key="NotificationRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderBrush" Value="{StaticResource ClineBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <!--  Pallino del colore d'accento  -->
        <Style x:Key="SwatchButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Ring.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Ellipse
                                x:Name="Ring"
                                Opacity="0"
                                Stroke="{StaticResource ClineText2Brush}"
                                StrokeThickness="1.5" />
                            <Ellipse Margin="3" Fill="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Icona dell'app selezionabile  -->
        <Style x:Key="AppIconButtonStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent" Spacing="6">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Frame.BorderBrush" Value="{StaticResource ClinePrimaryBrush}" />
                                            <Setter Target="Label.Foreground" Value="{StaticResource ClineText1Brush}" />
                                            <Setter Target="Label.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="Frame"
                                Width="58"
                                Height="58"
                                Padding="3"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="14">
                                <ContentPresenter />
                            </Border>
                            <TextBlock
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource ClineText2Brush}"
                                Text="{TemplateBinding Tag}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1105"
            Padding="68,36,68,48"
            HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource ClinePageTitleStyle}" Text="Impostazioni" />
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource ClinePageDescriptionStyle}"
                Text="Gestisci le preferenze dell'app desktop e dell'ambiente CLI." />

            <!--  Notifiche  -->
            <Grid Margin="0,36,0,16" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Notifiche desktop" />
                    <TextBlock Style="{StaticResource ClineSettingDescriptionStyle}" Text="Notifica solo quando la finestra di Cline è in secondo piano. Facendo clic su una notifica si apre la sua sessione." />
                    <TextBlock
                        x:Name="NotificationsBlockedText"
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="{StaticResource ClineErrorTextBrush}"
                        Text="Le notifiche sono bloccate nelle impostazioni di sistema."
                        Visibility="Collapsed" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Click="CheckPermission_Click"
                    Content="Controlla permessi"
                    Style="{StaticResource ClineChipButtonStyle}" />
            </Grid>

            <Border
                BorderBrush="{StaticResource ClineBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ClineRadiusLg}">
                <StackPanel x:Name="NotificationTable">
                    <Grid Padding="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            CharacterSpacing="40"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ClineText2Brush}"
                            Text="EVENTO" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            CharacterSpacing="40"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ClineText2Brush}"
                            Text="NOTIFICA" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            CharacterSpacing="40"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ClineText2Brush}"
                            Text="SUONO" />
                    </Grid>
                    <!--  Le righe degli eventi vengono aggiunte dal codice  -->
                </StackPanel>
            </Border>

            <!--  Tema scuro  -->
            <Grid Margin="0,16,0,0" Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Tema scuro" />
                    <TextBlock Style="{StaticResource ClineSettingDescriptionStyle}" Text="Mantieni l'interfaccia in modalità scura. Il tema chiaro arriverà più avanti." />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsEnabled="False"
                    IsOn="True"
                    Style="{StaticResource ClineBareToggleStyle}" />
            </Grid>

            <!--  Dimensione testo  -->
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Dimensione testo" />
                    <TextBlock Style="{StaticResource ClineSettingDescriptionStyle}" Text="Regola la dimensione del testo e degli elementi dell'interfaccia in tutta l'app." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Click="FontSmaller_Click"
                        ToolTipService.ToolTip="Riduci">
                        <FontIcon FontSize="10" Glyph="&#xE738;" />
                    </Button>
                    <Slider
                        x:Name="FontSizeSlider"
                        Width="116"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        Maximum="20"
                        Minimum="12"
                        StepFrequency="1"
                        ValueChanged="FontSizeSlider_ValueChanged"
                        Value="15" />
                    <Button
                        Width="28"
                        Height="28"
                        Padding="0"
                        Click="FontLarger_Click"
                        ToolTipService.ToolTip="Ingrandisci">
                        <FontIcon FontSize="10" Glyph="&#xE710;" />
                    </Button>
                    <TextBlock
                        x:Name="FontSizeText"
                        Width="36"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="15px"
                        TextAlignment="Right" />
                </StackPanel>
            </Grid>

            <!--  Colore d'accento  -->
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Colore d'accento" />
                    <TextBlock Style="{StaticResource ClineSettingDescriptionStyle}" Text="Colora pulsanti, link ed evidenziazioni in tutta l'app." />
                </StackPanel>
                <StackPanel
                    x:Name="AccentPanel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <RadioButton Background="#7E85FF" Checked="Accent_Checked" GroupName="Accent" Style="{StaticResource SwatchButtonStyle}" Tag="violet" ToolTipService.ToolTip="Viola" />
                    <RadioButton Background="#22272C" Checked="Accent_Checked" GroupName="Accent" Style="{StaticResource SwatchButtonStyle}" Tag="graphite" ToolTipService.ToolTip="Grafite" />
                    <RadioButton Background="#008FB3" Checked="Accent_Checked" GroupName="Accent" Style="{StaticResource SwatchButtonStyle}" Tag="cyan" ToolTipService.ToolTip="Ciano" />
                    <RadioButton Background="#E093B2" Checked="Accent_Checked" GroupName="Accent" Style="{StaticResource SwatchButtonStyle}" Tag="pink" ToolTipService.ToolTip="Rosa" />
                    <RadioButton Background="#4E3731" Checked="Accent_Checked" GroupName="Accent" Style="{StaticResource SwatchButtonStyle}" Tag="espresso" ToolTipService.ToolTip="Espresso" />
                    <RadioButton Background="#DA4528" Checked="Accent_Checked" GroupName="Accent" Style="{StaticResource SwatchButtonStyle}" Tag="ember" ToolTipService.ToolTip="Brace" />
                </StackPanel>
            </Grid>

            <!--  Icona dell'app  -->
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Icona dell'app" />
                    <TextBlock Style="{StaticResource ClineSettingDescriptionStyle}" Text="Scegli l'icona che Cline mostra sulla barra delle applicazioni." />
                </StackPanel>
                <StackPanel
                    x:Name="AppIconPanel"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">
                    <RadioButton Checked="AppIcon_Checked" GroupName="AppIcon" Style="{StaticResource AppIconButtonStyle}" Tag="Classic">
                        <Image Source="ms-appx:///Assets/AppIcons/classic.png" />
                    </RadioButton>
                    <RadioButton Checked="AppIcon_Checked" GroupName="AppIcon" Style="{StaticResource AppIconButtonStyle}" Tag="Midnight">
                        <Image Source="ms-appx:///Assets/AppIcons/midnight.png" />
                    </RadioButton>
                    <RadioButton Checked="AppIcon_Checked" GroupName="AppIcon" Style="{StaticResource AppIconButtonStyle}" Tag="Hologram">
                        <Image Source="ms-appx:///Assets/AppIcons/hologram.png" />
                    </RadioButton>
                    <RadioButton Checked="AppIcon_Checked" GroupName="AppIcon" Style="{StaticResource AppIconButtonStyle}" Tag="Chip">
                        <Image Source="ms-appx:///Assets/AppIcons/chip.png" />
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!--  Aggiornamento CLI  -->
            <Grid Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Mantieni aggiornata la CLI" />
                    <TextBlock Style="{StaticResource ClineSettingDescriptionStyle}" Text="Aggiorna automaticamente il comando cline del terminale, che condivide sessioni e impostazioni con questa app. L'app si aggiorna separatamente." />
                </StackPanel>
                <ToggleSwitch
                    x:Name="KeepCliUpdatedSwitch"
                    Grid.Column="1"
                    Style="{StaticResource ClineBareToggleStyle}"
                    Toggled="KeepCliUpdated_Toggled" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
