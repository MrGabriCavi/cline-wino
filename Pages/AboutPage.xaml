<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClineWin.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ClineBackgroundBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="856" Style="{StaticResource SettingsPageStackStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Style="{StaticResource ClinePageTitleStyle}" Text="Cline" />
                        <TextBlock
                            x:Name="VersionText"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="13"
                            Foreground="{StaticResource ClineText2Brush}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource ClinePageDescriptionStyle}"
                        Text="Client Windows nativo per Cline." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Spacing="6">
                    <Button
                        HorizontalAlignment="Right"
                        Click="CheckUpdates_Click"
                        Style="{StaticResource ClineChipButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE895;" />
                            <TextBlock Text="Controlla aggiornamenti" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="UpdateStatus"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{StaticResource ClineTextMutedBrush}" />
                </StackPanel>
            </Grid>

            <Grid MaxWidth="560" Margin="0,24,0,0" HorizontalAlignment="Left" Style="{StaticResource SettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Segnala un problema" />
                    <TextBlock Style="{StaticResource ClineSettingDescriptionStyle}" Text="Hai trovato un bug o hai una richiesta? Apri una segnalazione su GitHub." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="Issues_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xEBE8;" />
                        <TextBlock Text="Apri le segnalazioni" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,24,0,0">
                <TextBlock Style="{StaticResource ClineSectionTitleStyle}" Margin="0" Text="Note di rilascio" />
                <HyperlinkButton
                    HorizontalAlignment="Right"
                    Click="Changelog_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Changelog completo" />
                        <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                    </StackPanel>
                </HyperlinkButton>
            </Grid>
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource ClineCaptionTextStyle}"
                Text="Le note di rilascio non sono disponibili in questa build. Il changelog completo di Cline Desktop è su GitHub."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
