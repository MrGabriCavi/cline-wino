<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClineWin.LocalModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClineWin"
    Background="{StaticResource ClineBackgroundBrush}">

    <Page.Resources>
        <!--  Scheda selezionabile del runtime (Ollama / LM Studio)  -->
        <Style x:Key="RuntimeCardStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Card"
                            Padding="16,14"
                            Background="Transparent"
                            BorderBrush="{StaticResource ClineBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Card.BorderBrush" Value="{StaticResource ClinePrimaryBrush}" />
                                            <Setter Target="Dot.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Card.Background" Value="{StaticResource ClineHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Width="16"
                                    Height="16"
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top">
                                    <Ellipse Stroke="{StaticResource ClineText2Brush}" StrokeThickness="1.5" />
                                    <Ellipse
                                        x:Name="Dot"
                                        Margin="4"
                                        Fill="{StaticResource ClinePrimaryBrush}"
                                        Opacity="0" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="856" Style="{StaticResource SettingsPageStackStyle}">
            <TextBlock Style="{StaticResource ClinePageTitleStyle}" Text="Modelli locali" />
            <TextBlock Margin="0,12,0,0" Style="{StaticResource ClinePageDescriptionStyle}">
                <Run Text="Esegui i modelli sul tuo computer con Ollama o LM Studio. Scaricane uno, poi fai clic su " /><Run FontWeight="SemiBold" Text="Usa con Cline" /><Run Text=" per passare a quel modello con le impostazioni giuste." />
            </TextBlock>

            <!--  Scelta del runtime  -->
            <TextBlock Style="{StaticResource ClineSectionTitleStyle}" Text="Esegui i modelli con" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    x:Name="OllamaCard"
                    Checked="Runtime_Checked"
                    GroupName="Runtime"
                    Style="{StaticResource RuntimeCardStyle}"
                    Tag="ollama">
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock FontWeight="SemiBold" Text="Ollama" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Ellipse
                                    x:Name="OllamaDot"
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="OllamaStatus"
                                    FontSize="12"
                                    Foreground="{StaticResource ClineText2Brush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            FontSize="13"
                            Foreground="{StaticResource ClineText2Brush}"
                            Text="Leggero e open source. Funziona in silenzio in background."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="LmStudioCard"
                    Grid.Column="1"
                    Checked="Runtime_Checked"
                    GroupName="Runtime"
                    Style="{StaticResource RuntimeCardStyle}"
                    Tag="lmstudio">
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock FontWeight="SemiBold" Text="LM Studio" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Ellipse
                                    x:Name="LmStudioDot"
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="LmStudioStatus"
                                    FontSize="12"
                                    Foreground="{StaticResource ClineText2Brush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            FontSize="13"
                            Foreground="{StaticResource ClineText2Brush}"
                            Text="App desktop con il suo catalogo di modelli. Esegue modelli MLX per più velocità su Apple Silicon."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!--  Stato del runtime scelto  -->
            <Grid Margin="0,16,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    x:Name="StatusDot"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold" />
                <Button
                    Grid.Column="2"
                    Click="CheckAgain_Click"
                    Style="{StaticResource ClineIconButtonStyle}"
                    ToolTipService.ToolTip="Controlla di nuovo">
                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <!--  Istruzioni di installazione (runtime non installato)  -->
            <Border
                x:Name="InstallCard"
                Margin="0,12,0,0"
                Padding="20"
                Style="{StaticResource ClineCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="InstallStep1"
                            FontSize="13"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="DownloadButton"
                            Click="Download_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel x:Name="CommandPanel" Spacing="6">
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource ClineText2Brush}"
                                Text="Oppure installa solo il servizio in background, senza l'app:" />
                            <Grid
                                Padding="10,6"
                                Background="{StaticResource ClineSurface3Brush}"
                                ColumnSpacing="8"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="CommandText"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True" />
                                <Button
                                    x:Name="CopyButton"
                                    Grid.Column="1"
                                    Padding="8,2"
                                    Click="Copy_Click"
                                    Content="Copia"
                                    FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        x:Name="InstallStep2"
                        FontSize="13"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="InstallStep3"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Modelli consigliati  -->
            <TextBlock Style="{StaticResource ClineSectionTitleStyle}" Text="Modelli consigliati" />
            <Border Style="{StaticResource ClineCardStyle}">
                <ItemsControl x:Name="ModelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LocalModelInfo">
                            <Grid
                                Padding="16,14"
                                BorderBrush="{StaticResource ClineBorderBrush}"
                                BorderThickness="{x:Bind TopBorder}"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <ItemsControl ItemsSource="{x:Bind Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border
                                                        Padding="6,1"
                                                        Background="{StaticResource ClineSurface3Brush}"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{StaticResource ClineText2Brush}"
                                                            Text="{x:Bind}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource ClineText2Brush}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="11"
                                        Foreground="{StaticResource ClineTextMutedBrush}"
                                        Text="{x:Bind Details}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind DownloadLabel}"
                                    IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                                    ToolTipService.ToolTip="Il download arriverà con il collegamento al backend" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock
                x:Name="FooterNote"
                Margin="0,16,0,0"
                FontSize="12"
                Foreground="{StaticResource ClineTextMutedBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
