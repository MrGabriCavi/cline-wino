<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClineWin.ByokPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClineWin"
    Background="{StaticResource ClineBackgroundBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ProviderRowTemplate" x:DataType="local:ProviderDefinition">
            <Grid Padding="4,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{x:Bind Name}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{StaticResource ClineTextMutedBrush}"
                        Glyph="{x:Bind AuthGlyph}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ClineTextMutedBrush}"
                        Text="{x:Bind AuthLabel}" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    FontSize="10"
                    Foreground="{StaticResource ClineTextMutedBrush}"
                    Glyph="&#xE76C;" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="40,36,40,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="560" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!--  Elenco provider  -->
        <Grid Padding="28,0,0,0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource ClinePageTitleStyle}" Text="Usa la tua chiave" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,8,0,0"
                        Style="{StaticResource ClinePageDescriptionStyle}"
                        Text="Collega un provider per iniziare a usare i suoi modelli." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Aggiungi provider"
                    Click="AddProvider_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE710;" />
                        <TextBlock Text="Aggiungi provider" />
                    </StackPanel>
                </Button>
            </Grid>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="1"
                PlaceholderText="Cerca provider"
                QueryIcon="Find"
                TextChanged="Search_TextChanged" />

            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="PopularHeader"
                        Margin="4,8,0,0"
                        Style="{StaticResource ClineColumnHeaderStyle}"
                        Text="POPOLARI" />
                    <TextBlock
                        x:Name="PopularHint"
                        Margin="4,0,0,4"
                        FontSize="12"
                        Foreground="{StaticResource ClineTextMutedBrush}"
                        Text="Accedi o aggiungi una chiave API per collegarti." />
                    <ListView
                        x:Name="PopularList"
                        IsItemClickEnabled="True"
                        ItemClick="Provider_ItemClick"
                        ItemContainerStyle="{StaticResource ClineSidebarItemStyle}"
                        ItemTemplate="{StaticResource ProviderRowTemplate}"
                        SelectionMode="Single" />
                    <TextBlock
                        x:Name="AllHeader"
                        Margin="4,16,0,4"
                        Style="{StaticResource ClineColumnHeaderStyle}"
                        Text="TUTTI I PROVIDER" />
                    <ListView
                        x:Name="AllList"
                        IsItemClickEnabled="True"
                        ItemClick="Provider_ItemClick"
                        ItemContainerStyle="{StaticResource ClineSidebarItemStyle}"
                        ItemTemplate="{StaticResource ProviderRowTemplate}"
                        SelectionMode="Single" />
                    <TextBlock
                        x:Name="NoMatchText"
                        Margin="4,8,0,0"
                        Style="{StaticResource ClineCaptionTextStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  Dettaglio del provider scelto  -->
        <ScrollViewer
            x:Name="DetailPane"
            Grid.Column="1"
            Visibility="Collapsed">
            <StackPanel Spacing="16">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            x:Name="DetailTitle"
                            FontSize="22"
                            FontWeight="SemiBold" />
                        <Border
                            Padding="8,2"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource ClineInputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock
                                x:Name="StatusBadgeText"
                                FontSize="12"
                                Foreground="{StaticResource ClineText2Brush}"
                                Text="Non configurato" />
                        </Border>
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        Click="CloseDetail_Click"
                        Style="{StaticResource ClineIconButtonStyle}"
                        ToolTipService.ToolTip="Chiudi">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!--  Provider locale (Ollama, LM Studio): nessuna chiave  -->
                <Border
                    x:Name="LocalCard"
                    Padding="20"
                    Style="{StaticResource ClineCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="In esecuzione su questo computer" />
                        <TextBlock
                            x:Name="LocalText"
                            FontSize="13"
                            Foreground="{StaticResource ClineText2Brush}"
                            TextWrapping="Wrap" />
                        <HyperlinkButton
                            Padding="0"
                            Click="OpenLocalModels_Click"
                            Content="Apri Modelli locali per installarlo o controllarne lo stato"
                            FontSize="13" />
                    </StackPanel>
                </Border>

                <!--  Provider personalizzato: indirizzi e rimozione  -->
                <Border
                    x:Name="CustomCard"
                    Padding="20"
                    Style="{StaticResource ClineCardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock FontWeight="SemiBold" Text="Provider personalizzato" />
                            <Button
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Rimuovi provider"
                                Click="RemoveProvider_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    <TextBlock Text="Rimuovi provider" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            x:Name="CustomUrlText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            Foreground="{StaticResource ClineText2Brush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="CustomWarningText"
                            FontSize="12"
                            Foreground="{StaticResource ClineErrorTextBrush}"
                            Text="L'indirizzo usa http senza cifratura: la chiave API viaggia in chiaro."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Chiave API  -->
                <Grid
                    x:Name="ApiKeyRow"
                    ColumnSpacing="16"
                    Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource ClineSettingTitleStyle}" Text="Chiave API" />
                        <HyperlinkButton
                            x:Name="KeyLink"
                            Padding="0"
                            Click="KeyLink_Click"
                            FontSize="13" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <PasswordBox
                            x:Name="ApiKeyBox"
                            Width="220"
                            AutomationProperties.Name="Chiave API"
                            BorderBrush="{StaticResource ClineInputBorderBrush}"
                            BorderThickness="1"
                            PasswordChanged="ApiKeyBox_PasswordChanged"
                            PasswordRevealMode="Peek"
                            PlaceholderText="Incolla la chiave" />
                        <Button
                            x:Name="SaveKeyButton"
                            Click="SaveKey_Click"
                            Content="Salva"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="RemoveKeyButton"
                            Click="RemoveKey_Click"
                            Style="{StaticResource ClineIconButtonStyle}"
                            ToolTipService.ToolTip="Rimuovi la chiave"
                            AutomationProperties.Name="Rimuovi la chiave"
                            Visibility="Collapsed">
                            <FontIcon FontSize="13" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="ApiKeyNote"
                    FontSize="12"
                    Foreground="{StaticResource ClineTextMutedBrush}"
                    TextWrapping="Wrap" />

                <!--  Modelli  -->
                <Border Style="{StaticResource ClineCardStyle}">
                    <StackPanel>
                        <Grid Padding="16,10">
                            <TextBlock FontWeight="SemiBold" Text="Modelli" />
                            <Button
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Aggiorna modelli"
                                Click="RefreshModels_Click"
                                Style="{StaticResource ClineIconButtonStyle}"
                                ToolTipService.ToolTip="Carica i modelli dal provider">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                        <Border
                            Padding="16,12"
                            BorderBrush="{StaticResource ClineBorderBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="ModelsStatusText"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ClineCaptionTextStyle}"
                                    Text="Fai clic su aggiorna per caricare i modelli."
                                    TextWrapping="Wrap" />
                                <ListView
                                    x:Name="ModelsList"
                                    MaxHeight="320"
                                    SelectionMode="None"
                                    Visibility="Collapsed">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ModelInfo">
                                            <StackPanel Padding="0,3">
                                                <TextBlock FontSize="13" Text="{x:Bind Name}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    FontSize="11"
                                                    Foreground="{StaticResource ClineText2Brush}"
                                                    Text="{x:Bind Id}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
