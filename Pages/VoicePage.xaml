<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClineWin.VoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ClineBackgroundBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="856" Style="{StaticResource SettingsPageStackStyle}">
            <TextBlock Style="{StaticResource ClinePageTitleStyle}" Text="Input vocale" />
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource ClinePageDescriptionStyle}"
                Text="Parla invece di scrivere: il microfono nella chat trascrive la tua voce con il modello scelto qui. Il testo compare mentre parli; Stop termina la sessione dal vivo." />

            <!--  Stato vuoto: nessun provider con trascrizione in streaming  -->
            <Border
                MaxWidth="672"
                Margin="0,32,0,0"
                Padding="32,40"
                HorizontalAlignment="Left"
                BorderBrush="{StaticResource ClineInputBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ClineRadiusLg}">
                <StackPanel HorizontalAlignment="Center" Spacing="14">
                    <Border
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ClineSurface3Brush}"
                        CornerRadius="{StaticResource ClineRadiusLg}">
                        <FontIcon
                            FontSize="20"
                            Foreground="{StaticResource ClineText2Brush}"
                            Glyph="&#xE720;" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="L'input vocale richiede un provider di modelli configurato"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource ClineText2Brush}"
                        Text="Collega un provider con modelli di trascrizione in streaming e questa pagina si sblocca da sola."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="OpenProviders_Click"
                        Content="Apri i provider di modelli" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
