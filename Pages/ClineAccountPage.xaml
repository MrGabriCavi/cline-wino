<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClineWin.ClineAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ClineBackgroundBrush}">

    <ScrollViewer>
        <StackPanel
            MaxWidth="856"
            Padding="68,36,68,48"
            HorizontalAlignment="Left">

            <!--  Titolo con badge "In uso"  -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Style="{StaticResource ClinePageTitleStyle}" Text="Account Cline" />
                <Border
                    Padding="8,2"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource ClineInputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ToolTipService.ToolTip="La chat usa questo provider">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{StaticResource ClineSuccessBrush}" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="In uso" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock
                MaxWidth="640"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource ClinePageDescriptionStyle}"
                Text="I modelli più recenti di Anthropic, OpenAI, Google e altri con un solo account. Paga a consumo o abbonati a ClinePass." />

            <!--  Schede  -->
            <SelectorBar
                x:Name="Tabs"
                Margin="0,28,0,0"
                SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem IsSelected="True" Tag="overview" Text="Panoramica" />
                <SelectorBarItem Tag="usage" Text="Utilizzo" />
                <SelectorBarItem Tag="billing" Text="Fatturazione" />
            </SelectorBar>
            <Rectangle
                Height="1"
                Margin="0,0,0,24"
                Fill="{StaticResource ClineBorderBrush}" />

            <!--  Scheda di accesso (utente non collegato)  -->
            <Border
                Padding="24,48"
                BorderBrush="{StaticResource ClineBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ClineRadiusLg}">
                <StackPanel
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    Spacing="16">
                    <Border
                        Width="46"
                        Height="46"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ClinePrimarySoftBrush}"
                        CornerRadius="{StaticResource ClineRadiusLg}">
                        <FontIcon
                            FontSize="20"
                            Foreground="{StaticResource ClinePrimaryBrush}"
                            Glyph="&#xE77B;" />
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Accedi a Cline" />
                        <TextBlock
                            x:Name="TabDescription"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource ClineText2Brush}"
                            Text="Collega il tuo account Cline per vedere crediti, utilizzo, fatturazione e organizzazioni."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="SignInButton"
                            AutomationProperties.Name="Accedi"
                            Height="34"
                            Padding="12,0"
                            Click="SignIn_Click"
                            CornerRadius="{StaticResource ClineRadiusLg}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="SignInIcon"
                                    FontSize="14"
                                    Glyph="&#xE8FA;" />
                                <ProgressRing
                                    x:Name="SignInProgress"
                                    Width="14"
                                    Height="14"
                                    Foreground="White"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <TextBlock x:Name="SignInText" Text="Accedi" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SecondaryButton"
                            AutomationProperties.Name="Crea account"
                            Height="34"
                            Padding="12,0"
                            Click="Secondary_Click"
                            CornerRadius="{StaticResource ClineRadiusLg}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="SecondaryText" Text="Crea account" />
                                <FontIcon
                                    x:Name="ExternalIcon"
                                    FontSize="12"
                                    Glyph="&#xE8A7;" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="ErrorText"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource ClineErrorTextBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="CodePanel"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource ClineText2Brush}"
                        Visibility="Collapsed">
                        <Run Text="Conferma questo codice nel browser: " />
                        <Run
                            x:Name="CodeRun"
                            FontFamily="Cascadia Mono, Consolas"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ClineText1Brush}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
